<Window x:Class="TradingCompany.WPF.Views.DeliveryOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TradingCompany.ViewModels;assembly=TradingCompany.ViewModels"
        xmlns:dto="clr-namespace:TradingCompany.Core.DTOs;assembly=TradingCompany.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeliveryOrdersViewModel}"
        Title="Замовлення на доставку" Width="1150" Height="660" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateWaybillCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type dto:DeliveryOrderDto}">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding OrderNumber, StringFormat=Замовлення {0}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadgeTemplate}" Margin="0,4,0,8" />

                <TextBlock Text="{Binding OrderDate, StringFormat=Дата: {0:dd.MM.yyyy HH:mm}}" />
                <TextBlock Text="{Binding TotalAmount, StringFormat=Сума: {0:N2} грн}" />
                <TextBlock Text="{Binding CustomerName, StringFormat=Клієнт: {0}}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding CustomerPhone, StringFormat=Телефон: {0}}" />

                <Separator Margin="0,10" />
                <TextBlock FontWeight="SemiBold" Text="Накладна" />
                <TextBlock x:Name="txtNoWaybill" Text="Ще не створена." Foreground="Gray" Visibility="Collapsed" />
                <StackPanel x:Name="pnlWaybill">
                    <TextBlock Text="{Binding WaybillNumber, StringFormat=Номер: {0}}" />
                    <TextBlock Text="{Binding City, StringFormat=Місто: {0}}" />
                    <TextBlock Text="{Binding DeliveryAddress, StringFormat=Адреса: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeliveryMethod, StringFormat=Доставка: {0}}" />
                    <TextBlock Text="{Binding PaymentType, StringFormat=Оплата: {0}}" />
                    <TextBlock Text="{Binding DispatchedAt, StringFormat=Відправлено: {0:dd.MM.yyyy HH:mm}, TargetNullValue=Відправлення ще не підтверджено}" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding WaybillId}" Value="{x:Null}">
                    <Setter TargetName="pnlWaybill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="txtNoWaybill" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Оновити" Command="{Binding LoadCommand}" InputGestureText="F5" />
                <MenuItem Header="_Головна сторінка" Command="{Binding GoHomeCommand}" />
                <Separator />
                <MenuItem Header="_Вийти з облікового запису" Command="{Binding LogoutCommand}" />
            </MenuItem>
            <MenuItem Header="_Замовлення">
                <MenuItem Header="_Створити накладну..." Command="{Binding CreateWaybillCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Підтвердити відправлення" Command="{Binding ConfirmDispatchCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Summary}" />
            <Separator />
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Вийти" Margin="0" Command="{Binding LogoutCommand}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"
                           Text="{Binding UserName, StringFormat=Менеджер: {0}}" />
                <TextBlock Style="{StaticResource HeaderText}" Text="Замовлення на доставку" />
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,6,10,10">
                <WrapPanel>
                    <StackPanel Margin="0,0,0,0">
                        <Label Style="{StaticResource FieldLabel}" Content="_Пошук (номер, клієнт, місто, накладна):" Target="{Binding ElementName=txtSearch}" />
                        <TextBox x:Name="txtSearch" Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabel}" Content="Дата _з:" Target="{Binding ElementName=dpFrom}" />
                        <DatePicker x:Name="dpFrom" Width="125" SelectedDate="{Binding DateFrom}" />
                    </StackPanel>
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabel}" Content="Дата п_о:" Target="{Binding ElementName=dpTo}" />
                        <DatePicker x:Name="dpTo" Width="125" SelectedDate="{Binding DateTo}" />
                    </StackPanel>
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabel}" Content="_Статус:" Target="{Binding ElementName=cmbStatus}" />
                        <ComboBox x:Name="cmbStatus" Width="170" ItemsSource="{Binding Statuses}"
                                  DisplayMemberPath="Name" SelectedItem="{Binding SelectedStatus}" />
                    </StackPanel>
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabel}" Content="Сор_тування:" Target="{Binding ElementName=cmbSort}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="cmbSort" Width="150" Margin="0,0,6,0" ItemsSource="{Binding SortOptions}"
                                      DisplayMemberPath="Title" SelectedItem="{Binding SelectedSort}" />
                            <CheckBox Content="за спаданням" VerticalAlignment="Center" Margin="0,0,14,0"
                                      IsChecked="{Binding SortDescending}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Скинути фільтри" VerticalAlignment="Bottom" Command="{Binding ResetFiltersCommand}" />
                </WrapPanel>
            </Border>

            <TextBlock Grid.Row="2" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding ErrorMessage}" />

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="400" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ замовлення" Binding="{Binding OrderNumber}" Width="Auto" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Клієнт" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Сума, грн" Binding="{Binding TotalAmount, StringFormat=N2}" Width="Auto" />
                        <DataGridTextColumn Header="Накладна" Binding="{Binding WaybillNumber}" Width="Auto" />
                        <DataGridTextColumn Header="Місто" Binding="{Binding City}" Width="Auto" />
                        <DataGridTemplateColumn Header="Статус" Width="Auto" CellTemplate="{StaticResource StatusBadgeTemplate}" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Створити накладну" Margin="0,0,0,6"
                                    Command="{Binding CreateWaybillCommand}" />
                            <Button Content="Підтвердити відправлення" Margin="0"
                                    Command="{Binding ConfirmDispatchCommand}" />
                        </StackPanel>

                        <Grid>
                            <TextBlock Text="Виберіть замовлення у списку." Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding SelectedOrder}" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
